<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F5F5F5"
    android:fillViewport="true"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Tiêu đề -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="⚖️ TÍNH CHỈ SỐ BMI"
            android:textSize="20sp"
            android:textStyle="bold"
            android:textColor="#1A3E30"
            android:gravity="center"
            android:layout_marginBottom="20dp"/>

        <!-- Nhãn Chiều cao -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Chiều cao (cm)"
            android:textColor="#1A3E30"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <!-- Ô nhập chiều cao -->
        <EditText
            android:id="@+id/etHeightBmi"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ví dụ: 170"
            android:inputType="numberDecimal"
            android:background="@drawable/bg_gender_unselected"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="12dp"/>

        <!-- Nhãn Cân nặng -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Cân nặng (kg)"
            android:textColor="#1A3E30"
            android:textSize="13sp"
            android:textStyle="bold"
            android:layout_marginBottom="4dp"/>

        <!-- Ô nhập cân nặng -->
        <EditText
            android:id="@+id/etWeightBmi"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Ví dụ: 65"
            android:inputType="numberDecimal"
            android:background="@drawable/bg_gender_unselected"
            android:paddingHorizontal="16dp"
            android:layout_marginBottom="20dp"/>

        <!-- Nút tính -->
        <Button
            android:id="@+id/btnCalculateBmi"
            android:layout_width="match_parent"
            android:layout_height="52dp"
            android:text="TÍNH CHỈ SỐ BMI"
            android:textColor="#FFFFFF"
            android:textStyle="bold"
            android:textSize="15sp"
            android:backgroundTint="#1A3E30"
            android:layout_marginBottom="20dp"/>

        <!-- Card kết quả -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gender_unselected"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="20dp"
            android:layout_marginBottom="20dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Chỉ số BMI của bạn"
                android:textColor="#6B7280"
                android:textSize="14sp"/>

            <TextView
                android:id="@+id/tvBmiResult"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="--"
                android:textSize="32sp"
                android:textStyle="bold"
                android:textColor="#1A3E30"
                android:layout_marginVertical="6dp"/>

            <TextView
                android:id="@+id/tvBmiStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nhập thông tin để kiểm tra"
                android:textColor="#374151"
                android:textSize="15sp"
                android:textStyle="bold"/>
        </LinearLayout>

        <!-- Bảng mốc chỉ số BMI chuẩn WHO -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_gender_unselected"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="📌 Bảng mốc chỉ số BMI (Chuẩn WHO)"
                android:textStyle="bold"
                android:textColor="#1A3E30"
                android:textSize="15sp"
                android:layout_marginBottom="12dp"/>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Gầy (Thiếu cân)" android:textColor="#D97706"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="&lt; 18.5" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Bình thường" android:textColor="#059669" android:textStyle="bold"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="18.5 - 24.9" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="6dp">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Thừa cân" android:textColor="#D97706"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="25.0 - 29.9" android:textStyle="bold"/>
            </LinearLayout>

            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal">
                <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Béo phì" android:textColor="#DC2626"/>
                <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="≥ 30.0" android:textStyle="bold"/>
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>