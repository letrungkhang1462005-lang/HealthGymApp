<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B2B20">

    <!-- Header Trên cùng (code tự thêm khoảng đệm phía trên để không bị thanh trạng thái che) -->
    <LinearLayout
        android:id="@+id/layoutHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:minHeight="56dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="16dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:clickable="true"
            android:focusable="true"
            android:gravity="center"
            android:text="〈"
            android:textColor="#FFFFFF"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="32dp"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Chi tiết bữa ăn"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Khung nội dung trắng bo góc -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/layoutHeader"
        android:background="@drawable/bg_card_white"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="20dp">

            <!-- 1. Ảnh minh họa món ăn -->
            <ImageView
                android:id="@+id/imgMeal"
                android:layout_width="match_parent"
                android:layout_height="180dp"
                android:scaleType="centerCrop"
                android:src="@android:drawable/ic_menu_gallery"
                android:background="@drawable/bg_stat_item"
                android:layout_marginBottom="16dp"/>

            <!-- 2. Tên món ăn -->
            <TextView
                android:id="@+id/tvMealTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#111827"
                android:textSize="18sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <!-- 3. Nhãn Tag (Bữa ăn, Mục tiêu) -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <TextView
                    android:id="@+id/tvMealTypeTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#D1FAE5"
                    android:textColor="#065F46"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"
                    android:layout_marginEnd="8dp"/>

                <TextView
                    android:id="@+id/tvMealGoalTag"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#D1FAE5"
                    android:textColor="#065F46"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:textSize="12sp"
                    android:textStyle="bold"/>
            </LinearLayout>

            <!-- 4. Calo và các chất dinh dưỡng -->
            <TextView
                android:id="@+id/tvMealNutriSummary"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#4B5563"
                android:textSize="13sp"
                android:textStyle="bold"
                android:layout_marginBottom="16dp"/>

            <!-- Trạng thái: đang soạn chi tiết / báo lỗi (bấm để thử lại) -->
            <LinearLayout
                android:id="@+id/layoutDetailLoading"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:layout_marginBottom="16dp">

                <ProgressBar
                    android:id="@+id/progressDetail"
                    style="?android:attr/progressBarStyleSmall"
                    android:layout_width="20dp"
                    android:layout_height="20dp"/>

                <TextView
                    android:id="@+id/tvDetailStatus"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="10dp"
                    android:textColor="#059669"
                    android:textSize="13sp"/>
            </LinearLayout>

            <!-- 5. Khối Thành phần nguyên liệu (code tự thêm từng dòng) -->
            <LinearLayout
                android:id="@+id/layoutIngredientsCard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_stat_item"
                android:orientation="vertical"
                android:padding="16dp"
                android:layout_marginBottom="20dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Thành phần"
                    android:textColor="#111827"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:id="@+id/layoutIngredients"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"/>
            </LinearLayout>

            <!-- 6. Cách chế biến -->
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Cách chế biến"
                android:textColor="#111827"
                android:textSize="16sp"
                android:textStyle="bold"
                android:layout_marginBottom="8dp"/>

            <TextView
                android:id="@+id/tvCookingSteps"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#4B5563"
                android:textSize="14sp"
                android:lineSpacingExtra="4dp"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:id="@+id/tvTip"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textColor="#059669"
                android:textSize="13sp"
                android:visibility="gone"
                android:layout_marginBottom="12dp"/>

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Công thức do AI gợi ý, chỉ mang tính tham khảo."
                android:textColor="#9CA3AF"
                android:textSize="11sp"
                android:layout_marginBottom="16dp"/>

            <!-- 7. Nút Lưu vào nhật ký -->
            <Button
                android:id="@+id/btnSaveToLog"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:text="Lưu vào nhật ký"
                android:textSize="15sp"
                android:textStyle="bold"
                android:backgroundTint="#035D38"
                android:textColor="#FFFFFF"
                android:layout_marginBottom="30dp"/>

        </LinearLayout>
    </ScrollView>

</RelativeLayout>