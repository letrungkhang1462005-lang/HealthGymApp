<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B2B20">

    <!-- HEADER TIÊU ĐỀ TRÊN CÙNG -->
    <LinearLayout
        android:id="@+id/headerBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:paddingHorizontal="20dp"
        android:paddingTop="24dp"
        android:paddingBottom="12dp">

        <TextView
            android:id="@+id/btnBack"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="←"
            android:textColor="#FFFFFF"
            android:textSize="22sp"
            android:textStyle="bold"
            android:clickable="true"
            android:focusable="true"
            android:paddingEnd="16dp"/>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Chi tiết nhịp tim"
            android:textColor="#FFFFFF"
            android:textSize="18sp"
            android:textStyle="bold"/>
    </LinearLayout>

    <!-- NỘI DUNG CUỘN Ở DƯỚI HEADER -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/headerBar"
        android:layout_above="@id/bottomNavigation"
        android:fillViewport="true"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="16dp"
            android:paddingBottom="20dp">

            <!-- KHUNG NỘI DUNG TRẮNG -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_card_profile"
                android:orientation="vertical"
                android:padding="16dp"
                android:elevation="4dp">

                <!-- 1. CÁC TAB NGÀY / TUẦN / THÁNG -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="40dp"
                    android:background="@drawable/bg_edit_text"
                    android:orientation="horizontal"
                    android:padding="3dp"
                    android:layout_marginBottom="16dp">

                    <TextView
                        android:id="@+id/tabDay"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:background="@drawable/bg_gender_selected"
                        android:gravity="center"
                        android:text="Ngày"
                        android:textColor="#FFFFFF"
                        android:textStyle="bold"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tabWeek"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Tuần"
                        android:textColor="#7A9187"
                        android:textSize="13sp"/>

                    <TextView
                        android:id="@+id/tabMonth"
                        android:layout_width="0dp"
                        android:layout_height="match_parent"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="Tháng"
                        android:textColor="#7A9187"
                        android:textSize="13sp"/>
                </LinearLayout>

                <!-- 2. HEADER NHỊP TIM GẦN NHẤT -->
                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="12dp">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="❤️"
                            android:textSize="22sp"/>
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Nhịp tim"
                            android:textColor="#1A3E30"
                            android:textSize="18sp"
                            android:textStyle="bold"
                            android:layout_marginStart="8dp"/>
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:orientation="vertical"
                        android:gravity="end">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:gravity="bottom">
                            <TextView
                                android:id="@+id/tvCurrentBpm"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="--"
                                android:textColor="#1A3E30"
                                android:textSize="24sp"
                                android:textStyle="bold"/>
                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=" bpm"
                                android:textColor="#7A9187"
                                android:textSize="13sp"
                                android:layout_marginStart="2dp"/>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/tvBpmUpdated"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Chưa có dữ liệu"
                            android:textColor="#7A9187"
                            android:textSize="11sp"/>
                        <TextView
                            android:id="@+id/tvBpmStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="#059669"
                            android:textSize="11sp"
                            android:textStyle="bold"/>
                    </LinearLayout>
                </RelativeLayout>

                <!-- NÚT GHI NHỊP TIM -->
                <TextView
                    android:id="@+id/btnAddHeartRate"
                    android:layout_width="match_parent"
                    android:layout_height="44dp"
                    android:layout_marginBottom="16dp"
                    android:background="@drawable/bg_gender_selected"
                    android:gravity="center"
                    android:text="＋ Ghi nhịp tim"
                    android:textColor="#FFFFFF"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    android:clickable="true"
                    android:focusable="true"/>

                <!-- 3. KHUNG BIỂU ĐỒ (MPAndroidChart) -->
                <FrameLayout
                    android:layout_width="match_parent"
                    android:layout_height="220dp"
                    android:background="@drawable/bg_edit_text"
                    android:padding="8dp"
                    android:layout_marginBottom="20dp">

                    <com.github.mikephil.charting.charts.LineChart
                        android:id="@+id/chartHeartRate"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"/>

                    <TextView
                        android:id="@+id/tvChartEmpty"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:paddingHorizontal="16dp"
                        android:text="Chưa có dữ liệu nhịp tim trong khoảng này.\nBấm “Ghi nhịp tim” để thêm."
                        android:textColor="#7A9187"
                        android:textSize="12sp"
                        android:visibility="gone"/>
                </FrameLayout>

                <!-- 4. CHI TIẾT -->
                <TextView
                    android:id="@+id/tvDetailTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Chi tiết hôm nay"
                    android:textColor="#1A3E30"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginBottom="8dp">

                    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="❤️" android:textSize="14sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nhịp tim trung bình" android:textColor="#64748B" android:textSize="13sp" android:layout_marginStart="8dp"/>
                        <TextView android:id="@+id/tvAvgBpm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#1A3E30" android:textStyle="bold" android:textSize="13sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="❤️" android:textSize="14sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nhịp tim cao nhất" android:textColor="#64748B" android:textSize="13sp" android:layout_marginStart="8dp"/>
                        <TextView android:id="@+id/tvMaxBpm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#1A3E30" android:textStyle="bold" android:textSize="13sp"/>
                    </LinearLayout>

                    <LinearLayout android:layout_width="match_parent" android:layout_height="36dp" android:gravity="center_vertical">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥" android:textSize="14sp"/>
                        <TextView android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:text="Nhịp tim thấp nhất" android:textColor="#64748B" android:textSize="13sp" android:layout_marginStart="8dp"/>
                        <TextView android:id="@+id/tvMinBpm" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="--" android:textColor="#1A3E30" android:textStyle="bold" android:textSize="13sp"/>
                    </LinearLayout>
                </LinearLayout>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Thông tin chỉ mang tính tham khảo, không dùng để chẩn đoán y tế."
                    android:textColor="#7A9187"
                    android:textSize="10sp"
                    android:layout_marginBottom="20dp"/>

                <!-- 5. CÁC CHỈ SỐ KHÁC (dữ liệu mẫu) -->
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Các chỉ số khác (dữ liệu mẫu)"
                    android:textColor="#1A3E30"
                    android:textSize="15sp"
                    android:textStyle="bold"
                    android:layout_marginBottom="12dp"/>

                <GridLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:columnCount="2"
                    android:rowCount="2">

                    <LinearLayout android:layout_width="0dp" android:layout_height="65dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_edit_text" android:gravity="center_vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🏃" android:textSize="20sp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Bước chân" android:textColor="#64748B" android:textSize="10sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="8.420 bước" android:textColor="#1A3E30" android:textStyle="bold" android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="65dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_edit_text" android:gravity="center_vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🔥" android:textSize="20sp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Calories" android:textColor="#64748B" android:textSize="10sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="1.240 kcal" android:textColor="#1A3E30" android:textStyle="bold" android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="65dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_edit_text" android:gravity="center_vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="💧" android:textSize="20sp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Nước uống" android:textColor="#64748B" android:textSize="10sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="2.1 lít" android:textColor="#1A3E30" android:textStyle="bold" android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>

                    <LinearLayout android:layout_width="0dp" android:layout_height="65dp" android:layout_columnWeight="1" android:layout_margin="4dp" android:background="@drawable/bg_edit_text" android:gravity="center_vertical" android:padding="10dp">
                        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🌙" android:textSize="20sp"/>
                        <LinearLayout android:layout_width="wrap_content" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="8dp">
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Giấc ngủ" android:textColor="#64748B" android:textSize="10sp"/>
                            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="7h 20p" android:textColor="#1A3E30" android:textStyle="bold" android:textSize="12sp"/>
                        </LinearLayout>
                    </LinearLayout>

                </GridLayout>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <!-- THANH ĐIỀU HƯỚNG DƯỚI ĐÁY (Trang chủ sáng vì màn này mở từ Trang chủ) -->
    <LinearLayout
        android:id="@+id/bottomNavigation"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_alignParentBottom="true"
        android:background="#FFFFFF"
        android:orientation="horizontal"
        android:elevation="8dp"
        android:gravity="center_vertical"
        android:paddingHorizontal="10dp">

        <LinearLayout
            android:id="@+id/menuHome"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="👁️" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Trang chủ" android:textColor="#1A3E30" android:textSize="11sp" android:textStyle="bold"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuHistory"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🕒" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Lịch sử" android:textColor="#7A9187" android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuAiCoach"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="🤖" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="AI Coach" android:textColor="#7A9187" android:textSize="11sp"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/menuSettings"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:clickable="true"
            android:focusable="true">
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="⚙️" android:textSize="16sp"/>
            <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Cài đặt" android:textColor="#7A9187" android:textSize="11sp"/>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>